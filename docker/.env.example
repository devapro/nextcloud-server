#
# Copy to docker/.env and adjust. Every value below is also the compose default,
# so the stack runs without an .env file at all.

# Where Nextcloud and Adminer are published on the host
NEXTCLOUD_PORT=8080
ADMINER_PORT=8081

# Supported range is >= 8.3 and < 8.6 (lib/versioncheck.php); CI runs 8.3 and 8.5
PHP_VERSION=8.4

# UID/GID the web server runs as. Leave at 33 (www-data) on macOS and Windows.
# On Linux set these to `id -u` / `id -g` so the container can write to the
# checkout, then rebuild: docker compose build
NEXTCLOUD_UID=33
NEXTCLOUD_GID=33

# First-run admin account
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=admin

POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=nextcloud

# Comma-separated. Apps that exist in apps/ are enabled, the rest are pulled from
# the app store into the writable apps path. `viewer` is alwaysEnabled in
# core/shipped.json but not shipped in this repository.
NEXTCLOUD_APPS=viewer

# Extra entries for trusted_domains, comma-separated. localhost and
# localhost:$NEXTCLOUD_PORT are always trusted.
NEXTCLOUD_TRUSTED_DOMAINS=

# 0=debug, 1=info, 2=warning, 3=error, 4=fatal
NEXTCLOUD_LOGLEVEL=2

# off | debug,develop | coverage | profile -- see docker/README.md
XDEBUG_MODE=off

# Seconds between cron.php runs in the cron container
NEXTCLOUD_CRON_INTERVAL=300
